    "check:palette": "node scripts/check-palette.js",
    "check:orphan-css": "node scripts/check-orphan-css.js",
    "check:contrast:live": "node scripts/check-contrast-live.js",
    "palette:breakdown": "node scripts/palette-breakdown.js",
    "check:functions": "node scripts/check-edge-functions.js",
    "check:mcp-rewrite": "node scripts/check-mcp-rewrite.js",
    "deploy:function": "node scripts/deploy-function.js",
    "sql:staging": "node scripts/sql-staging.js",
    "mcp:probe": "node scripts/mcp-probe.js",
    "css:debt": "node scripts/css-debt.js",
    "css:diff": "node scripts/css-diff.js",
    "blocks:diff": "node scripts/blocks-diff.js",
    "diff:db": "node scripts/diff-db-vs-files.js",
    "load-probe": "node scripts/load-probe.js",
    "backup": "node scripts/backup-db.js",
    "backup:verify": "node scripts/backup-db.js --verify",
    "export:json": "node scripts/export-content-json.js",
    "preflight": "npm run check:lockfile && npm run check:node && npm run verify && npm run bump:check && npm run build:css -- --check && npm run check:tailwind && npm run check:cdn && npm run check:palette && npm run check:tokens && npm run check:i18n && npm run check:orphan-css && npm run check:safearea && npm run check:names && npm run check:hover && npm run check:csp && npm run check:mcp-rewrite && npm run check:budget && npm run check:seo && npm run check:contrast && npm run typecheck && npm run validate:schema && npm run build:ugc-sql -- --check && npm run build:pravila -- --check && npm run export:json -- --check && npm run check:docs && npm run check:state && npm run test:unit",
    "scaffold": "node scripts/scaffold-subject.js",
    "check:contrast": "node scripts/check-contrast.js",
    "check:safearea": "node scripts/check-safe-area.js",
    "check:names": "node scripts/check-names.js",
    "check:hover": "node scripts/check-hover.js",
    "check:csp": "node scripts/check-csp.js",
    "check:budget": "node scripts/check-budget.js",
    "check:seo": "node scripts/check-seo.js",
    "build:og": "node scripts/build-og-image.js"
