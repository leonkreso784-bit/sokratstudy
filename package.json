{
  "name": "sokrat-study",
  "version": "2.0.0",
  "description": "Sokrat Study — interactive exam-prep platform for FMTU Opatija (Hospitality Management): lessons, flashcards, quizzes, fill-in-the-blank and interactive exercises across Year 1 & 2 subjects (EN + HR).",
  "main": "index.html",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "npx serve .",
    "dev": "npx serve . -l 3000",
    "serve:test": "node scripts/static-server.js",
    "test:responsive": "playwright test",
    "test:authed": "playwright test --project=authenticated",
    "test:authed:mjeri": "node scripts/authed-mjera.js",
    "test:unit": "node scripts/test-unit.js",
    "test:rls": "node scripts/rls-check.js",
    "test:storage": "node scripts/storage-check.js",
    "test:delete-account": "node scripts/delete-account-check.js",
    "mcp:brava": "node scripts/mcp-brava-check.js",
    "mcp:nacrt": "node scripts/mcp-nacrt-check.js",
    "mcp:prihvat": "node scripts/mcp-prihvat-check.js",
    "mcp:predaja": "node scripts/mcp-predaja-check.js",
    "mcp:izmjena": "node scripts/mcp-izmjena-check.js",
    "mcp:alati": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/mcp-alati-check.js",
    "ugc:sadrzaj": "node scripts/ugc-sadrzaj-check.js",
    "build:ugc-sql": "node scripts/build-ugc-sql.js",
    "build:pravila": "node scripts/build-pravila.js",
    "staging:racuni": "node scripts/staging-test-racuni.js",
    "test:mail": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/mail-check.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "stats": "node scripts/compute-stats.js",
    "bump": "node scripts/bump-version.js",
    "bump:check": "node scripts/bump-version.js --check",
    "build:css": "node scripts/build-css.js",
    "verify": "node scripts/verify-catalog.js",
    "verify:catalog": "node scripts/verify-catalog.js",
    "validate:content": "node scripts/validate-content.js",
    "validate:schema": "node scripts/validate-json-schema.js",
    "check:final": "node scripts/check-final-drift.js",
    "check:docs": "node scripts/check-docs.js",
    "docs:rotate": "node scripts/rotiraj-zapise.js",
    "check:state": "node scripts/check-state.js",
    "check:lockfile": "node scripts/check-lockfile.js",
    "check:node": "node scripts/check-node.js",
    "check:tailwind": "node scripts/check-tailwind.js",
    "check:cdn": "node scripts/check-cdn.js",
    "check:cdn:live": "node scripts/check-cdn.js --verify",
    "check:tokens": "node scripts/check-tokens.js",
