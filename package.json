  "repository": {
    "type": "git",
    "url": "https://github.com/leonkreso784-bit/t2economyintourism.git"
  },
  "homepage": "https://www.sokratstudy.com",
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.60.0",
    "@tailwindcss/cli": "4.3.3",
    "ajv": "8.20.0",
    "axe-core": "4.12.1",
    "dotenv": "17.4.2",
    "lightningcss": "1.32.0",
    "pdf-parse": "2.4.5",
    "pg": "8.23.0",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "overrides": {
    "fast-uri": "3.1.5"
  }
